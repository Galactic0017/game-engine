# Copy to .env on Railway (Variables tab). Never commit a real .env.
ADMIN_KEY=change-me-dev-only-use-a-long-random-key
MODE=demo
CHAIN_ID=cosmoshub-4
EXPLORER_TX_URL=https://www.mintscan.io/cosmos/txs/
# CEO fee: 4 to 7 percent. Default 5. Buyer pays the full price, split as:
# seller gets price * (1 - fee), CEO gets price * fee, in two separate sends.
FEE_PERCENT=5
# CEO Cosmos address that receives the fee send. Replace with the real CEO address before any live use.
CEO_ADDRESS=cosmos1cccccccccccccccccccccccccccccccccccccc
PORT=3000
